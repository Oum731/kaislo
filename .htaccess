# ------------------------------------------------------------
# Réglages pour l'hébergement Hostinger (serveur Apache)
# ------------------------------------------------------------
# Toujours en HTTPS (obligatoire pour le Bluetooth et l'installation)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# Une seule adresse pour Google : www.kaislo.com → kaislo.com
RewriteCond %{HTTP_HOST} ^www\.kaislo\.com$ [NC]
RewriteRule ^(.*)$ https://kaislo.com/$1 [L,R=301]

# Anciennes adresses des pages par activité (« caisse-… » devenues « gestion-… »)
RewriteRule ^caisse-(restaurant|epicerie|boutique|quincaillerie|boulangerie|bar)/?$ /gestion-$1/ [R=301,L]
# Pages retirées (métier réglementé non proposé) : « 410 Gone » (disparue pour de bon), pas une redirection vers l'accueil
# (Google range une redirection vers une page sans rapport parmi les « pages avec redirection » ou les soft 404 ; le 410 la sort de l'index plus vite)
RewriteRule ^(caisse|gestion)-pharmacie/?$ - [G,L]
RewriteRule ^en/pharmacy-management/?$ - [G,L]
RewriteRule ^guides/gerer-le-stock-dune-pharmacie-peremptions/?$ - [G,L]
RewriteRule ^en/guides/managing-pharmacy-stock-and-expiry-dates/?$ - [G,L]
# Ancienne adresse des vidéos : vraie redirection 301 (le fichier Next /videos/ n'en est qu'un secours)
RewriteRule ^videos/?$ /tutoriels/ [R=301,L]

# L'adresse provisoire Hostinger est renvoyée vers kaislo.com (Google garde ainsi une seule adresse)
# En cas de problème avec le domaine : remettre un # devant les 2 lignes suivantes
RewriteCond %{HTTP_HOST} hostingersite\.com$ [NC]
RewriteRule ^(.*)$ https://kaislo.com/$1 [L,R=301]

# (Plus d'en-tête « noindex » : l'ancienne règle « sauf kaislo.com » était mal lue par le serveur (variable renommée
#  après une redirection interne) et bloquait Google sur kaislo.com. L'adresse provisoire est de toute façon redirigée vers kaislo.com.)

# Page d'erreur
ErrorDocument 404 /404.html

# Mise en cache des fichiers qui ne changent jamais (noms uniques)
<IfModule mod_headers.c>
  # Fichiers de Next.js (nom unique à chaque version) : gardés 1 an
  SetEnvIf Request_URI "^/_next/static/" fichier_fixe
  # Images et vidéos du site (captures, affiches, icônes, logos) : leur adresse porte le numéro de la publication (« ?v=… »,
  # voir src/config.js) : gardées 1 an, et une nouvelle image s'affiche tout de suite puisque son adresse change
  SetEnvIf Query_String "(^|&)v=" fichier_fixe
  Header set Cache-Control "public, max-age=31536000, immutable" env=fichier_fixe
  # Autres images, vidéos et icônes (sans numéro : photos de la démo, image de partage, icônes du manifeste) : gardées 30 jours
  <FilesMatch "\.(png|svg|webp|jpg|ico|mp4)$">
    Header set Cache-Control "public, max-age=2592000" env=!fichier_fixe
  </FilesMatch>
  # Manifestes de l'application : 1 heure
  <FilesMatch "\.webmanifest$">
    Header set Cache-Control "public, max-age=3600" env=!fichier_fixe
  </FilesMatch>
  <FilesMatch "(sw\.js|version\.json|\.html)$">
    Header set Cache-Control "no-cache"
    # Cache du serveur LiteSpeed (Hostinger) : jamais de copie périmée des pages
    Header set X-LiteSpeed-Cache-Control "no-cache"
  </FilesMatch>
  # Ouvrir https://kaislo.com/purge-cache.txt vide tout le cache du serveur (à faire après une publication si une ancienne page s'affiche)
  <FilesMatch "^purge-cache\.txt$">
    Header set X-LiteSpeed-Purge "*"
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

# Fichiers cachés (.env…) jamais accessibles depuis le web
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
Options -Indexes

# ------------------------------------------------------------
# Sécurité (en-têtes envoyés avec chaque page)
#  - HTTPS obligatoire pendant un an (HSTS)
#  - le site ne peut pas être affiché dans un autre site (protection contre le « clickjacking »)
#  - sources autorisées : le site lui-même, la carte OpenStreetMap et sa recherche d'adresse, et la balise de mesure Google Ads (chargée seulement après l'accord du visiteur)
#  - caméra (scan), position (carte) et Bluetooth (imprimante) : seulement pour Kaislo
# ------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), geolocation=(self), bluetooth=(self), microphone=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.google.com https://googleads.g.doubleclick.net https://www.googletagmanager.com https://www.facebook.com; font-src 'self' data:; connect-src 'self' https://nominatim.openstreetmap.org https://www.google.com https://googleads.g.doubleclick.net https://www.googleadservices.com https://www.googletagmanager.com https://*.google-analytics.com https://www.facebook.com https://connect.facebook.net; frame-src https://www.openstreetmap.org https://td.doubleclick.net; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>
