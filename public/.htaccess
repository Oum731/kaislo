# ------------------------------------------------------------
# Réglages pour l'hébergement Hostinger (serveur Apache)
# ------------------------------------------------------------
# Toujours en HTTPS (obligatoire pour le Bluetooth et l'installation)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# Une seule adresse pour Google : www.kaislo.com → kaislo.com
RewriteCond %{HTTP_HOST} ^www\.kaislo\.com$ [NC]
RewriteRule ^(.*)$ https://kaislo.com/$1 [L,R=301]

# Anciennes adresses des pages par activité (« caisse-… » devenues « gestion-… »)
RewriteRule ^caisse-(restaurant|epicerie|boutique|quincaillerie|pharmacie|boulangerie|bar)/?$ /gestion-$1/ [R=301,L]

# L'adresse provisoire Hostinger est renvoyée vers kaislo.com (Google garde ainsi une seule adresse)
# En cas de problème avec le domaine : remettre un # devant les 2 lignes suivantes
RewriteCond %{HTTP_HOST} hostingersite\.com$ [NC]
RewriteRule ^(.*)$ https://kaislo.com/$1 [L,R=301]

# Toute autre adresse que kaislo.com (domaine provisoire…) : pas d'indexation par Google
SetEnvIfNoCase Host ^kaislo\.com$ domaine_officiel

# Page d'erreur
ErrorDocument 404 /404.html

# Mise en cache des fichiers qui ne changent jamais (noms uniques)
<IfModule mod_headers.c>
  # Fichiers de Next.js (nom unique à chaque version) : gardés 1 an
  # Images, vidéos, icônes : gardées 1 heure (une nouvelle capture s'affiche vite)
  SetEnvIf Request_URI "^/_next/static/" fichier_fixe
  Header set Cache-Control "public, max-age=31536000, immutable" env=fichier_fixe
  <FilesMatch "\.(png|svg|webp|jpg|ico|mp4|webmanifest)$">
    Header set Cache-Control "public, max-age=3600" env=!fichier_fixe
  </FilesMatch>
  <FilesMatch "(sw\.js|\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Fichiers cachés (.env…) jamais accessibles depuis le web
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
Options -Indexes

# ------------------------------------------------------------
# Sécurité (en-têtes envoyés avec chaque page)
#  - HTTPS obligatoire pendant un an (HSTS)
#  - le site ne peut pas être affiché dans un autre site (protection contre le « clickjacking »)
#  - sources autorisées : le site lui-même, la carte OpenStreetMap et sa recherche d'adresse
#  - caméra (scan), position (carte) et Bluetooth (imprimante) : seulement pour Kaislo
# ------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=!domaine_officiel
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), geolocation=(self), bluetooth=(self), microphone=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://nominatim.openstreetmap.org; frame-src https://www.openstreetmap.org; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>
