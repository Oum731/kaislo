# ------------------------------------------------------------
# Réglages pour l'hébergement Hostinger (serveur Apache)
# ------------------------------------------------------------
# Toujours en HTTPS (obligatoire pour le Bluetooth et l'installation)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# Page d'erreur
ErrorDocument 404 /404.html

# Mise en cache des fichiers qui ne changent jamais (noms uniques)
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "(sw\.js|\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
